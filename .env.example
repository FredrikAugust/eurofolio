# Remote Turso/libSQL database. Never commit real values.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-a-database-token

# One random token (at least 32 characters) controls MCP access.
EUROFOLIO_OWNER_TOKEN=replace-with-a-high-entropy-owner-token

# Better Auth protects the dashboard with the single owner's email/password.
BETTER_AUTH_SECRET=replace-with-a-separate-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Vercel Cron bearer secret (at least 32 characters).
CRON_SECRET=replace-with-a-separate-cron-secret

# Optional temporary bearer secret for deliberate historical backfills.
BACKFILL_SECRET=

# Optional fallback provider. Eurofolio works without this key.
TWELVE_DATA_API_KEY=

# Optional tuning; values shown are the defaults.
PRICE_STALE_AFTER_DAYS=5
FX_STALE_AFTER_DAYS=3
